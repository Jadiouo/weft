__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.venv/

# 產物與中介檔（SDD §3.1）
work/
out/

# 合成測試影片：由 tests/synth/build.py 產生，15 秒可重建，不進版控
tests/fixtures/synth/*.mp4

# 真實影片黃金集：素材為他人著作（SDD §9 版權），只版控標註檔
tests/fixtures/golden/*.mp4
tests/fixtures/golden/*.webm

# R8 實驗的中間產物（可由 step1–5 重跑產生）
experiments/r8_overlay/sheets/
experiments/r8_overlay/runs/
experiments/r8_overlay/residual.json
experiments/r8_overlay/split.json

# 金鑰與本機環境。SDD §2.3：額度來源固定為 Gemini API key。
# key 應走環境變數（~/.bashrc），不要放進專案目錄——備份、同步工具、
# 誤複製目錄都可能把它帶出去。這些規則是萬一有人還是建了檔案時的防護。
.env
.env.*
!.env.example
*.key
*.pem
secrets.json
credentials.json
